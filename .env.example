# Optional: a form submission endpoint (e.g. https://formspree.io/f/xxxxxxx)
# that accepts a multipart/form-data POST and returns JSON.
# If left unset, the contact form falls back to opening a pre-filled mailto
# link — no backend, no secrets, no build-time requirement.
VITE_FORM_ENDPOINT=

# Optional: override the WhatsApp number used by the nav, contact section and
# floating action button. International format, digits only — no "+", spaces,
# brackets or hyphens (e.g. 254712345678).
# By default the site uses the phone number already published in
# src/data/profile.ts (it doubles as the WhatsApp number), so this only needs
# to be set if WhatsApp should use a *different* number.
VITE_WHATSAPP_NUMBER=
